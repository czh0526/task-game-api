syntax = "v1"

info (
	title:   "Task Game Open Protocol"
	desc:    "v0.1 HTTP API. Source for goctl. Contract: api/openapi.yaml."
	author:  "taskgame"
	version: "0.1.0"
)

type (
	HealthResp {
		Status string `json:"status"`
	}
	ListTasksReq {
		Status         string `form:"status,optional,options=draft|open|active|in_review|disputed|settled|cancelled"`
		Kind           string `form:"kind,optional,options=exclusive|competitive|collaborative"`
		Limit          int64  `form:"limit,optional"`
		Cursor         string `form:"cursor,optional"`
		Assignable     string `form:"assignable,optional"`
		IdempotencyKey string `header:"Idempotency-Key,optional" json:"-"`
	}
	TaskList {
		Items      []Task  `json:"items"`
		NextCursor *string `json:"next_cursor,optional"`
	}
	Payment {
		Mode       string      `json:"mode,options=one_shot|milestone"`
		Amount     int64       `json:"amount"`
		Milestones []Milestone `json:"milestones,optional,omitempty"`
		Conditions []string    `json:"conditions,optional,omitempty"`
	}
	Milestone {
		Id        string `json:"id"`
		Amount    int64  `json:"amount"`
		Condition string `json:"condition"`
		Status    string `json:"status,optional,options=pending|submitted|released|disputed"`
	}
	Acceptance {
		Deadline    string   `json:"deadline"`
		Quality     string   `json:"quality"`
		Constraints []string `json:"constraints,optional,omitempty"`
		ReviewHours  int64    `json:"review_hours,optional"`
		MaxRevisions int64    `json:"max_revisions,optional"`
	}
	AssigneePolicy {
		Type       string   `json:"type,options=specific|criteria|open"`
		UserIds    []string `json:"user_ids,optional,omitempty"`
		MinAbility *int64   `json:"min_ability,optional,omitempty"`
	}
	Competitive {
		Slots          int64  `json:"slots"`
		SettlementRule string `json:"settlement_rule,optional,options=winner_take_all"`
	}
	CollaborativeRole {
		Id             string  `json:"id"`
		Name           string  `json:"name"`
		Quantity       *int64  `json:"quantity,optional,omitempty"`
		ShareBps       int64   `json:"share_bps"`
		TemplateId     string  `json:"template_id,optional,omitempty"`
		AssigneeUserId *string `json:"assignee_user_id,optional"`
		Status         string  `json:"status,optional,options=open|filled|dropped|submitted|settled|refunded"`
	}
	Collaborative {
		Roles          []CollaborativeRole `json:"roles"`
		OnDropout      string              `json:"on_dropout,optional,options=replace"`
		SettlementMode string              `json:"settlement_mode,optional,options=per_seat|unified"`
	}
	CreateTaskReq {
		IdempotencyKey string         `header:"Idempotency-Key,optional" json:"-"`
		Kind           string         `json:"kind,options=exclusive|competitive|collaborative"`
		Title          string         `json:"title"`
		Description    string         `json:"description"`
		Payment        Payment        `json:"payment"`
		Acceptance     Acceptance     `json:"acceptance"`
		AssigneePolicy AssigneePolicy `json:"assignee_policy"`
		Competitive    *Competitive   `json:"competitive,optional,omitempty"`
		Collaborative  *Collaborative `json:"collaborative,optional,omitempty"`
	}
	EscrowEntry {
		Id        string `json:"id"`
		Type      string `json:"type"`
		Amount    int64  `json:"amount"`
		ToUserId  string `json:"to_user_id,optional,omitempty"`
		CreatedAt string `json:"created_at"`
	}
	EscrowAccount {
		Id       string        `json:"id"`
		Held     int64         `json:"held"`
		Currency string        `json:"currency"`
		Entries  []EscrowEntry `json:"entries"`
	}
	Task {
		Kind                string         `json:"kind"`
		Title               string         `json:"title"`
		Description         string         `json:"description"`
		Payment             Payment        `json:"payment"`
		Acceptance          Acceptance     `json:"acceptance"`
		AssigneePolicy      AssigneePolicy `json:"assignee_policy"`
		Competitive         *Competitive   `json:"competitive,optional,omitempty"`
		Collaborative       *Collaborative `json:"collaborative,optional,omitempty"`
		Id                  string         `json:"id"`
		Status              string         `json:"status"`
		PublisherId         string         `json:"publisher_id"`
		ExecutorIds         []string       `json:"executor_ids"`
		WinningSubmissionId *string        `json:"winning_submission_id,optional"`
		ReviewDeadline      *string        `json:"review_deadline,optional"`
		Escrow              *EscrowAccount `json:"escrow,optional,omitempty"`
		CreatedAt           string         `json:"created_at"`
		UpdatedAt           string         `json:"updated_at"`
	}
	GetTaskReq {
		TaskId string `path:"taskId" json:"-"`
	}
	FundTaskReq {
		TaskId         string `path:"taskId" json:"-"`
		IdempotencyKey string `header:"Idempotency-Key,optional" json:"-"`
	}
	AcceptTaskReq {
		TaskId         string `path:"taskId" json:"-"`
		IdempotencyKey string `header:"Idempotency-Key,optional" json:"-"`
		RoleId         string `json:"role_id,optional"`
	}
	SubmitTaskReq {
		TaskId         string                 `path:"taskId" json:"-"`
		IdempotencyKey string                 `header:"Idempotency-Key,optional" json:"-"`
		MilestoneId    string                 `json:"milestone_id,optional"`
		Payload        map[string]interface{} `json:"payload"`
		Note           string                 `json:"note,optional,omitempty"`
	}
	ConfirmTaskReq {
		TaskId         string `path:"taskId" json:"-"`
		IdempotencyKey string `header:"Idempotency-Key,optional" json:"-"`
		SubmissionId   string `json:"submission_id,optional"`
		MilestoneId    string `json:"milestone_id,optional"`
		RoleId         string `json:"role_id,optional"`
	}
	StartTaskReq {
		TaskId         string `path:"taskId" json:"-"`
		IdempotencyKey string `header:"Idempotency-Key,optional" json:"-"`
	}
	DisputeTaskReq {
		TaskId         string `path:"taskId" json:"-"`
		IdempotencyKey string `header:"Idempotency-Key,optional" json:"-"`
		Reason         string `json:"reason"`
		RoleId         string `json:"role_id,optional"`
	}
	CancelTaskReq {
		TaskId         string `path:"taskId" json:"-"`
		IdempotencyKey string `header:"Idempotency-Key,optional" json:"-"`
		Reason         string `json:"reason,optional"`
	}
	ReviseTaskReq {
		TaskId         string `path:"taskId" json:"-"`
		IdempotencyKey string `header:"Idempotency-Key,optional" json:"-"`
		Reason         string `json:"reason"`
		RoleId         string `json:"role_id,optional"`
		SubmissionId   string `json:"submission_id,optional"`
	}
	ResolveTaskReq {
		TaskId         string `path:"taskId" json:"-"`
		IdempotencyKey string `header:"Idempotency-Key,optional" json:"-"`
		Outcome        string `json:"outcome"`
		Reason         string `json:"reason,optional"`
		RoleId         string `json:"role_id,optional"`
		SubmissionId   string `json:"submission_id,optional"`
	}
	ArbitrateTaskReq {
		TaskId         string `path:"taskId" json:"-"`
		IdempotencyKey string `header:"Idempotency-Key,optional" json:"-"`
		Outcome        string `json:"outcome"`
		Reason         string `json:"reason"`
		RoleId         string `json:"role_id,optional"`
		SubmissionId   string `json:"submission_id,optional"`
	}
	InviteUsersReq {
		TaskId         string   `path:"taskId" json:"-"`
		IdempotencyKey string   `header:"Idempotency-Key,optional" json:"-"`
		UserIds        []string `json:"user_ids"`
	}
	ListTaskInvitesReq {
		TaskId string `path:"taskId" json:"-"`
	}
	ListMyInvitesReq {
		Status string `form:"status,optional"`
	}
	DeclineInviteReq {
		InviteId       string `path:"inviteId" json:"-"`
		IdempotencyKey string `header:"Idempotency-Key,optional" json:"-"`
	}
	GetChatReq {
		ChatId string `path:"chatId" json:"-"`
	}
	ListChatsReq {
		TaskId string `form:"task_id,optional"`
	}
	ListMessagesReq {
		ChatId string `path:"chatId" json:"-"`
		Limit  int64  `form:"limit,optional"`
		Cursor string `form:"cursor,optional"`
	}
	DropoutTaskReq {
		TaskId         string `path:"taskId" json:"-"`
		IdempotencyKey string `header:"Idempotency-Key,optional" json:"-"`
	}
	CreateWebhookReq {
		IdempotencyKey string   `header:"Idempotency-Key,optional" json:"-"`
		Url            string   `json:"url"`
		Secret         string   `json:"secret"`
		Events         []string `json:"events"`
	}
	Webhook {
		Url       string   `json:"url"`
		Secret    string   `json:"secret"`
		Events    []string `json:"events"`
		Id        string   `json:"id"`
		CreatedAt string   `json:"created_at"`
	}
	CreateChatReq {
		IdempotencyKey string   `header:"Idempotency-Key,optional" json:"-"`
		Type           string   `json:"type,optional"`
		UserId         string   `json:"user_id,optional"`
		MemberIds      []string `json:"member_ids,optional"`
		TaskId         string   `json:"task_id,optional"`
	}
	Chat {
		Id        string   `json:"id"`
		Type      string   `json:"type"`
		TaskId    *string  `json:"task_id,optional"`
		MemberIds []string `json:"member_ids"`
	}
	ChatList {
		Items []Chat `json:"items"`
	}
	MessageList {
		Items      []Message `json:"items"`
		NextCursor *string   `json:"next_cursor,optional"`
	}
	Invite {
		Id        string `json:"id"`
		TaskId    string `json:"task_id"`
		UserId    string `json:"user_id"`
		Status    string `json:"status"`
		CreatedAt string `json:"created_at"`
		UpdatedAt string `json:"updated_at"`
	}
	InviteList {
		Items []Invite `json:"items"`
	}
	PostMessageReq {
		ChatId         string `path:"chatId" json:"-"`
		IdempotencyKey string `header:"Idempotency-Key,optional" json:"-"`
		Type           string `json:"type,options=text|attachment_ref"`
		Text           string `json:"text,optional,omitempty"`
		AttachmentRef  string `json:"attachment_ref,optional,omitempty"`
	}
	Message {
		Type          string `json:"type"`
		Text          string `json:"text,optional,omitempty"`
		AttachmentRef string `json:"attachment_ref,optional,omitempty"`
		Id            string `json:"id"`
		ChatId        string `json:"chat_id"`
		SenderId      string `json:"sender_id"`
		CreatedAt     string `json:"created_at"`
	}
	MarkChatReadReq {
		ChatId         string `path:"chatId" json:"-"`
		IdempotencyKey string `header:"Idempotency-Key,optional" json:"-"`
		MessageId      string `json:"message_id,optional"`
	}
	ChatRead {
		ChatId               string  `json:"chat_id"`
		UnreadCount          int64   `json:"unread_count"`
		ReadThroughMessageId *string `json:"read_through_message_id"`
	}
	GetUserScoresReq {
		UserId string `path:"userId" json:"-"`
	}
	ScoreChange {
		DeltaIntegrity int64  `json:"delta_integrity"`
		DeltaAbility   int64  `json:"delta_ability"`
		Reason         string `json:"reason"`
		TaskId         string `json:"task_id,optional,omitempty"`
		CreatedAt      string `json:"created_at"`
	}
	UserScores {
		UserId    string        `json:"user_id"`
		Integrity int64         `json:"integrity"`
		Ability   int64         `json:"ability"`
		Recent    []ScoreChange `json:"recent"`
	}
	RegisterReq {
		Email    string `json:"email"`
		Password string `json:"password"`
	}
	LoginReq {
		Email    string `json:"email"`
		Password string `json:"password"`
	}
	UserSummary {
		Id        string `json:"id"`
		Email     string `json:"email"`
		IsArbiter bool   `json:"is_arbiter"`
	}
	AuthSession {
		AccessToken string      `json:"access_token"`
		ExpiresIn   int64       `json:"expires_in"`
		User        UserSummary `json:"user"`
	}
	Friend {
		UserId       string  `json:"user_id"`
		Integrity    int64   `json:"integrity"`
		Ability      int64   `json:"ability"`
		Since        string  `json:"since"`
		UnreadCount  int64   `json:"unread_count"`
		DirectChatId *string `json:"direct_chat_id"`
	}
	FriendGroup {
		Id        string `json:"id"`
		Name      string `json:"name"`
		SortOrder int64  `json:"sort_order"`
	}
	FriendGroupWithFriends {
		Id        string   `json:"id"`
		Name      string   `json:"name"`
		SortOrder int64    `json:"sort_order"`
		Friends   []Friend `json:"friends"`
	}
	FriendList {
		Groups    []FriendGroupWithFriends `json:"groups"`
		Ungrouped []Friend                 `json:"ungrouped"`
	}
	FriendRequest {
		Id         string `json:"id"`
		FromUserId string `json:"from_user_id"`
		ToUserId   string `json:"to_user_id"`
		Status     string `json:"status"`
		CreatedAt  string `json:"created_at"`
		UpdatedAt  string `json:"updated_at"`
	}
	FriendRequestList {
		Items []FriendRequest `json:"items"`
	}
	FriendGroupList {
		Items []FriendGroup `json:"items"`
	}
	RemovedFriend {
		UserId string `json:"user_id"`
	}
	FriendPlacement {
		UserId  string  `json:"user_id"`
		GroupId *string `json:"group_id"`
	}
	CreateFriendRequestReq {
		IdempotencyKey string `header:"Idempotency-Key,optional" json:"-"`
		UserId         string `json:"user_id"`
	}
	ListFriendRequestsReq {
		Direction string `form:"direction,optional"`
	}
	FriendRequestActionReq {
		RequestId      string `path:"requestId" json:"-"`
		IdempotencyKey string `header:"Idempotency-Key,optional" json:"-"`
	}
	UnfriendReq {
		UserId         string `path:"userId" json:"-"`
		IdempotencyKey string `header:"Idempotency-Key,optional" json:"-"`
	}
	CreateFriendGroupReq {
		IdempotencyKey string `header:"Idempotency-Key,optional" json:"-"`
		Name           string `json:"name"`
	}
	PatchFriendGroupReq {
		GroupId        string  `path:"groupId" json:"-"`
		IdempotencyKey string  `header:"Idempotency-Key,optional" json:"-"`
		Name           *string `json:"name,optional"`
		SortOrder      *int64  `json:"sort_order,optional"`
	}
	DeleteFriendGroupReq {
		GroupId        string `path:"groupId" json:"-"`
		IdempotencyKey string `header:"Idempotency-Key,optional" json:"-"`
	}
	SetFriendGroupReq {
		UserId         string  `path:"userId" json:"-"`
		IdempotencyKey string  `header:"Idempotency-Key,optional" json:"-"`
		GroupId        *string `json:"group_id,optional"`
	}
)

@server (
	group: health
)
service taskgame {
	@handler health
	get /health returns (HealthResp)
}

@server (
	prefix: /v1
	group:  session
)
service taskgame {
	@handler register
	post /register (RegisterReq) returns (AuthSession)

	@handler login
	post /login (LoginReq) returns (AuthSession)
}

@server (
	prefix:     /v1
	group:      task
	middleware: Auth
)
service taskgame {
	@handler listTasks
	get /tasks (ListTasksReq) returns (TaskList)

	@handler createTask
	post /tasks (CreateTaskReq) returns (Task)

	@handler getTask
	get /tasks/:taskId (GetTaskReq) returns (Task)

	@handler fundTask
	post /tasks/:taskId/fund (FundTaskReq) returns (Task)

	@handler acceptTask
	post /tasks/:taskId/accept (AcceptTaskReq) returns (Task)

	@handler startTask
	post /tasks/:taskId/start (StartTaskReq) returns (Task)

	@handler submitTask
	post /tasks/:taskId/submit (SubmitTaskReq) returns (Task)

	@handler confirmTask
	post /tasks/:taskId/confirm (ConfirmTaskReq) returns (Task)

	@handler disputeTask
	post /tasks/:taskId/dispute (DisputeTaskReq) returns (Task)

	@handler cancelTask
	post /tasks/:taskId/cancel (CancelTaskReq) returns (Task)

	@handler reviseTask
	post /tasks/:taskId/revise (ReviseTaskReq) returns (Task)

	@handler resolveTask
	post /tasks/:taskId/resolve (ResolveTaskReq) returns (Task)

	@handler arbitrateTask
	post /tasks/:taskId/arbitrate (ArbitrateTaskReq) returns (Task)

	@handler listTaskInvites
	get /tasks/:taskId/invites (ListTaskInvitesReq) returns (InviteList)

	@handler inviteTask
	post /tasks/:taskId/invites (InviteUsersReq) returns (InviteList)

	@handler dropoutTask
	post /tasks/:taskId/dropout (DropoutTaskReq) returns (Task)
}

@server (
	prefix:     /v1
	group:      webhook
	middleware: Auth
)
service taskgame {
	@handler createWebhook
	post /webhooks (CreateWebhookReq) returns (Webhook)
}

@server (
	prefix:     /v1
	group:      chat
	middleware: Auth
)
service taskgame {
	@handler listChats
	get /chats (ListChatsReq) returns (ChatList)

	@handler createChat
	post /chats (CreateChatReq) returns (Chat)

	@handler getChat
	get /chats/:chatId (GetChatReq) returns (Chat)

	@handler listMessages
	get /chats/:chatId/messages (ListMessagesReq) returns (MessageList)

	@handler postMessage
	post /chats/:chatId/messages (PostMessageReq) returns (Message)

	@handler markChatRead
	post /chats/:chatId/read (MarkChatReadReq) returns (ChatRead)
}

@server (
	prefix:     /v1
	group:      user
	middleware: Auth
)
service taskgame {
	@handler getMe
	get /me returns (UserSummary)

	@handler listMyInvites
	get /me/invites (ListMyInvitesReq) returns (InviteList)

	@handler declineInvite
	post /invites/:inviteId/decline (DeclineInviteReq) returns (Invite)

	@handler getUserScores
	get /users/:userId/scores (GetUserScoresReq) returns (UserScores)
}

@server (
	prefix:     /v1
	group:      friend
	middleware: Auth
)
service taskgame {
	@handler listFriends
	get /friends returns (FriendList)

	@handler createFriendRequest
	post /friends/requests (CreateFriendRequestReq) returns (FriendRequest)

	@handler unfriend
	delete /friends/:userId (UnfriendReq) returns (RemovedFriend)

	@handler setFriendGroup
	put /friends/:userId/group (SetFriendGroupReq) returns (FriendPlacement)

	@handler listFriendRequests
	get /friend-requests (ListFriendRequestsReq) returns (FriendRequestList)

	@handler acceptFriendRequest
	post /friend-requests/:requestId/accept (FriendRequestActionReq) returns (FriendRequest)

	@handler declineFriendRequest
	post /friend-requests/:requestId/decline (FriendRequestActionReq) returns (FriendRequest)

	@handler cancelFriendRequest
	delete /friend-requests/:requestId (FriendRequestActionReq) returns (FriendRequest)

	@handler listFriendGroups
	get /friend-groups returns (FriendGroupList)

	@handler createFriendGroup
	post /friend-groups (CreateFriendGroupReq) returns (FriendGroup)

	@handler updateFriendGroup
	patch /friend-groups/:groupId (PatchFriendGroupReq) returns (FriendGroup)

	@handler deleteFriendGroup
	delete /friend-groups/:groupId (DeleteFriendGroupReq) returns (FriendGroup)
}

